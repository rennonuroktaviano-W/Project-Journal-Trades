# Konfigurasi lokal TradeLedger.
# File ini di-gitignore. Jangan pernah commit kredensial asli.
# Salin file ini menjadi .env.local lalu isi nilainya.

# ---------------------------------------------------------------------------
# Database (PRD 6, 7)
# Akun aplikasi: DML umum, TIDAK punya UPDATE/DELETE pada tabel append-only.
# Akun migrasi : DDL penuh, hanya dipakai `prisma migrate`.
# Keduanya dibuat oleh database/01-bootstrap.sql
# ---------------------------------------------------------------------------
DATABASE_URL="mysql://tradeledger_app:PASSWORD_APP@127.0.0.1:3306/tradeledger"
DATABASE_MIGRATE_URL="mysql://tradeledger_migrate:PASSWORD_MIGRATE@127.0.0.1:3306/tradeledger"

# MySQL 8.4 memakai caching_sha2_password. Tanpa TLS, driver harus mengambil
# kunci RSA publik dari server sebelum handshake selesai; itu hanya aman untuk
# loopback lokal. WAJIB true di produksi, dengan sertifikat CA yang valid.
DATABASE_SSL="false"

# Shadow database untuk mendeteksi drift saat migrate. Akun migrasi sengaja
# tidak diberi hak CREATE DATABASE, jadi basis data ini dibuat manual oleh
# database/01-bootstrap.sql.
DATABASE_SHADOW_URL="mysql://tradeledger_migrate:PASSWORD_MIGRATE@127.0.0.1:3306/tradeledger_shadow"

# ---------------------------------------------------------------------------
# Aplikasi
# ---------------------------------------------------------------------------
NODE_ENV="development"
PORT="3000"

# URL dasar situs. NEXT_PUBLIC_* terekspos ke browser, jangan pernah berisi secret.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="TradeLedger"

# Rahasia penanda tangan cookie sesi.
# Buat dengan: openssl rand -base64 32
# Wajib diganti di produksi. Minimal 32 karakter.
SESSION_SECRET="GANTI_DENGAN_HASIL_OPENSSL_RAND_BASE64_32"

# Umur cookie sesi dalam detik (PRD 9.1 session timeout). 30 hari.
SESSION_MAX_AGE="2592000"

# ---------------------------------------------------------------------------
# Password hashing (PRD 9.2)
# Argon2id dengan parameter contoh dari RFC 9106 tingkat 2.
# ---------------------------------------------------------------------------
ARGON2_MEMORY_COST="19456"
ARGON2_TIME_COST="2"
ARGON2_PARALLELISM="1"

# ---------------------------------------------------------------------------
# Anti brute force (PRD 9.1, AUTH-03)
# ---------------------------------------------------------------------------
LOGIN_RATE_LIMIT_PER_IP="5"
LOGIN_RATE_LIMIT_PER_ACCOUNT="5"
LOGIN_LOCKOUT_THRESHOLD="10"
LOGIN_LOCKOUT_MINUTES="30"

# Cek password bocor lewat API k-anonim HIBP (AUTH-01).
# Set true untuk mengaktifkan; default false agar development tidak lambat.
CHECK_BREACHED_PASSWORDS="false"

# Umur token reset password dalam detik (AUTH-04). 60 menit.
PASSWORD_RESET_TTL="3600"

# ---------------------------------------------------------------------------
# Upload screenshot (PRD 4.2 JRN-05, 9.1)
# Folder ini berada di luar public root dan tidak dieksekusi sebagai kode.
# ---------------------------------------------------------------------------
UPLOAD_DIR="./storage/uploads"
UPLOAD_MAX_BYTES="2097152"
UPLOAD_MAX_PER_TRADE="3"

# ---------------------------------------------------------------------------
# Data pasar (PRD 4.5)
# Server hanya memanggil domain whitelisted ini (proteksi SSRF).
# ---------------------------------------------------------------------------
MARKET_DATA_ENABLED="false"
BINANCE_BASE_URL="https://api.binance.com"
BYBIT_BASE_URL="https://api.bybit.com"

# ---------------------------------------------------------------------------
# Job terjadwal (PRD 6, tabel jobs)
# ---------------------------------------------------------------------------
JOB_POLL_INTERVAL_MS="5000"
JOB_BATCH_SIZE="10"

# ---------------------------------------------------------------------------
# PENTINGAN: jangan dipakai di produksi.
# PRD 9.1 mensyaratkan debug dimatikan di produksi.
# ---------------------------------------------------------------------------
DEBUG="true"